# --- KRL Cloud 컨트롤 플레인 ---
PORT=8080
BASE_DOMAIN=krl.kr
DATA_FILE=./data/db.json
TICK_SECONDS=60

# --- Cloudflare (name.krl.kr 서브도메인 자동 발급 + 자동 HTTPS) ---
# 토큰 권한: Zone.DNS:Edit (커스텀 도메인 SSL 을 쓰려면 SSL and Certificates:Edit 도 추가)
CF_API_TOKEN=
CF_ZONE_ID=
# 컨트롤 플레인 서버의 공인 IP(A 레코드) 또는 호스트명(CNAME)
CF_ORIGIN=
